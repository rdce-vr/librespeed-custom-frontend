server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # ==============================
    # YOUR CUSTOM FRONTEND & STATIC FALLBACK
    # ==============================

    # Force serving our custom index.html for root, index.php, or index.html
    location = / {
        try_files /index.html =404;
    }

    location = /index.php {
        try_files /index.html =404;
    }

    location = /index.html {
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ @backend;
    }

    # Fallback backend handler for missing assets (like speedtest.js, logo.svg, etc.)
    location @backend {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==============================
    # LIBRESPEED TEST API
    # ==============================

    location ~ ^/(backend/)?(empty|garbage|getIP|telemetry)\.php$ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

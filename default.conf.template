server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # ==============================
    # YOUR CUSTOM FRONTEND
    # ==============================

    location / {
        try_files $uri $uri/ =404;
    }

    # ==============================
    # LIBRESPEED FRONTEND ASSETS
    # ==============================

    location = /speedtest.js {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/speedtest.js;
    }

    location = /speedtest_worker.js {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/speedtest_worker.js;
    }

    location = /server-list.json {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/server-list.json;
    }

    location /images/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/images/;
    }

    location /fonts/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/fonts/;
    }

    # ==============================
    # LIBRESPEED TEST API
    # ==============================

    location ~ ^/(empty|garbage|getIP|telemetry)\.php$ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # ==============================
    # YOUR CUSTOM FRONTEND & STATIC FALLBACK
    # ==============================

    # Force serving our custom index.html for root, index.php, or index.html
    location = / {
        try_files /index.html =404;
    }

    location = /index.php {
        try_files /index.html =404;
    }

    location = /index.html {
        try_files /index.html =404;
    }

    # ==============================
    # LIBRESPEED FRONTEND ASSETS
    # ==============================

    location = /speedtest.js {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/speedtest.js;
        proxy_set_header Host $proxy_host;
    }

    location = /speedtest_worker.js {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/speedtest_worker.js;
        proxy_set_header Host $proxy_host;
    }

    location = /server-list.json {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/server-list.json;
        proxy_set_header Host $proxy_host;
    }

    location /images/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/images/;
        proxy_set_header Host $proxy_host;
    }

    location /fonts/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/fonts/;
        proxy_set_header Host $proxy_host;
    }

    # ==============================
    # LIBRESPEED TEST API
    # ==============================

    location ~ ^/(backend/)?(empty|garbage|getIP|telemetry)\.php$ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve custom files and CSS locally
    location / {
        try_files $uri $uri/ =404;
    }
}
